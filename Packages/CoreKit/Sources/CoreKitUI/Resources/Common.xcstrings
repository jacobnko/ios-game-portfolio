    "settings.resetProgressMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle geschafften Level, Sterne und Bestzeiten gehen verloren. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears every cleared stage, star and best time. It cannot be undone."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los niveles completados, estrellas y mejores tiempos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les niveaux réussis, étoiles et meilleurs temps seront effacés. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリアしたステージ、スター、ベストタイムがすべて消えます。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클리어한 스테이지, 별, 최고 기록이 모두 사라집니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as fases concluídas, estrelas e melhores tempos serão apagados. Não dá para desfazer."
          }
        }
      }
    },
