# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# XcodeGen output — regenerate with `xcodegen generate`, never edit by hand
Tools/*/*.xcodeproj
Tools/*/Info.plist

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/
# Package.resolved is committed on purpose — dependency versions must be reproducible.

# CocoaPods / Carthage (not used, guarded anyway)
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets — never commit real ad unit IDs or service configs
*.p8
*.p12
*.mobileprovision
Secrets.xcconfig
GoogleService-Info.plist

# Private planning material — the public repo must not expose the unreleased
# game roadmap, concepts or brand names.
PLAN.md
docs/concepts/

# Game apps are tracked in their own separate repositories.
# This repo holds only the shared architecture, docs and templates.
# See docs/architecture/repo-strategy.md
Apps/*
!Apps/README.md

# Design working files (deliverables are committed, raw exports are not)
docs/design/**/assets/*.psd
docs/design/**/assets/*.sketch
*.fig

# Per-game design handoff folders — same leak risk as docs/concepts/: briefs
# name the unreleased brand and describe the core mechanic in plain language.
# The template stays tracked; every numbered game folder does not.
docs/design/[0-9]*/
